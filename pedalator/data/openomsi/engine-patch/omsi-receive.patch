+/// A plugin's `omsi.receive`: one socket on `127.0.0.1:port`, opened on the first call.
+#[derive(Default)]
+struct Receiver {
+    socket: Option<(u16, UdpSocket)>,
+}
+
+/// Most datagrams one `omsi.receive` hands over (the rest are dropped, newest kept).
+const RECEIVE_MAX: usize = 64;
+
+impl Receiver {
+    fn receive(&mut self, port: i64) -> Result<Vec<Vec<u8>>, String> {
+        let port = u16::try_from(port).ok().filter(|p| *p >= 1024).ok_or("the port must be 1024-65535")?;
+        if MULTIPLAYER_PORTS.contains(&port) {
+            return Err(format!("ports {}-{} are the game's multiplayer", MULTIPLAYER_PORTS.start, MULTIPLAYER_PORTS.end - 1));
+        }
+        if self.socket.as_ref().is_some_and(|(p, _)| *p != port) {
+            return Err("a plugin listens on one port only".into());
+        }
+        if self.socket.is_none() {
+            let socket = UdpSocket::bind((Ipv4Addr::LOCALHOST, port)).map_err(|e| e.to_string())?;
+            socket.set_nonblocking(true).map_err(|e| e.to_string())?;
+            self.socket = Some((port, socket));
+        }
+        let socket = &self.socket.as_ref().expect("opened above").1;
+        let mut out: Vec<Vec<u8>> = Vec::new();
+        let mut buf = [0u8; SEND_MAX];
+        // (a datagram is read whole; at most a second's worth are looked at per call)
+        for _ in 0..1000 {
+            match socket.recv_from(&mut buf) {
+                Ok((n, _)) => {
+                    if out.len() == RECEIVE_MAX {
+                        out.remove(0);
+                    }
+                    out.push(buf[..n].to_vec());
+                }
+                Err(_) => break,
+            }
+        }
+        Ok(out)
+    }
+}
